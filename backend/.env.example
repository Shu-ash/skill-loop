# Environment Mode (production / development)
NODE_ENV=production

# Server Port (Render automatically sets PORT in production)
PORT=5000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.nkxmspg.mongodb.net/skillloop?retryWrites=true&w=majority

# JWT Secrets (Generate random 64-character hex strings)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long

# JWT Token Expiration
JWT_ACCESS_EXPIRES=30d
JWT_REFRESH_EXPIRES=90d

# Frontend URL (For standalone frontend deployments e.g. https://skill-loop2-0.onrender.com)
CLIENT_URL=https://skill-loop2-0.onrender.com

# Set to true when running over HTTPS (Render enforces HTTPS)
COOKIE_SECURE=true

# Brevo (Sendinblue) Email & OTP Configuration
BREVO_API_KEY=your_brevo_api_key_here
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_login@smtp-brevo.com
SMTP_PASS=your_smtp_key_here
SMTP_SECURE=false
EMAIL_FROM=your_verified_sender_email@gmail.com
EMAIL_USER=your_login@smtp-brevo.com
EMAIL_PASS=your_smtp_key_here